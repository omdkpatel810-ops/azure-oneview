// Ten or more failed SSH password logins to one server from one address in 10 minutes.
Syslog
| where Facility in ("auth", "authpriv") and ProcessName == "sshd"
| extend Account = extract(@"^Failed password for (?:invalid user )?(\S+) from ", 1, SyslogMessage),
         SourceIP = extract(@" from (\S+) port \d+", 1, SyslogMessage)
| where isnotempty(Account) and isnotempty(SourceIP)
| summarize Attempts = count(), Accounts = make_set(Account, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by Host = HostName, SourceIP
| where Attempts >= 10
