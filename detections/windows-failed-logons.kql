// Ten or more failed logins (event 4625) for one account on one server in 10 minutes.
SecurityEvent
| where EventID == 4625
| summarize Attempts = count(), Sources = make_set(IpAddress, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by Host = Computer, Account = TargetAccount
| where Attempts >= 10
